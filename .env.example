ANTHROPIC_API_KEY=sk-ant-...        # só necessário se o claude CLI não estiver autenticado via `claude login`

# Claude Code CLI
CLAUDE_CODE_BIN=claude               # caminho para o binário (padrão: claude, deve estar no PATH)
CLAUDE_CODE_WORK_DIR=/path/to/project  # diretório onde os agentes trabalham (padrão: cwd do servidor)
CLAUDE_CODE_MAX_TURNS=5              # máximo de turns por agente (padrão: 5)
